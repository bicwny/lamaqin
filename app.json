{
  "expo": {
    "name": "expo-on-replit",
    "slug": "expo-on-replit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dharmapractice",
    "userInterfaceStyle": "automatic",
    "deepLinking": {
      "prefixes": ["dharmapractice://"],
      "paths": [
        "/(tabs)",
        "/(tabs)/practice",
        "/(tabs)/study", 
        "/(tabs)/mindfulness",
        "/(tabs)/stats",
        "/(tabs)/profile",
        "/meditation-history",
        "/add-practice",
        "/practice-config",
        "/modals/custom-record",
        "/modals/meditation-record",
        "/auth",
        "/auth/login",
        "/auth/register"
      ]
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "fontDisplay": "swap"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "943c08b8-8051-4c2d-9c99-ece545b667be"
      }
    },
    "owner": "bicwny",
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}