{
  "expo": {
    "name": "三殊胜",
    "slug": "expo-on-replit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sanshusheng",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bicwny.sanshusheng",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "三殊胜 uses notifications to remind you of your daily practice sessions and to notify you of important practice milestones."
      }
    },
    "android": {
      "package": "com.bicwny.sanshusheng",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png",
      "fontDisplay": "swap",
      "display": "standalone",
      "name": "三殊胜",
      "shortName": "三殊胜",
      "description": "Buddhist practice tracking application",
      "backgroundColor": "#ffffff",
      "themeColor": "#7C3AED",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/",
      "preferRelatedApplications": false,
      "meta": {
        "apple": {
          "mobileWebAppCapable": "yes",
          "mobileWebAppStatusBarStyle": "black-translucent",
          "touchFullscreen": "yes"
        }
      },
      "config": {
        "firebase": {
          "measurementId": ""
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "943c08b8-8051-4c2d-9c99-ece545b667be"
      }
    },
    "owner": "bicwny",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/943c08b8-8051-4c2d-9c99-ece545b667be"
    }
  }
}
