entrypoint = "README.md"
modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "EAS Init"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eas init"

[[workflows.workflow]]
name = "EAS Update"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eas update --auto"

[[workflows.workflow]]
name = "EAS Publish Preview iOS"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eas build --platform ios --profile preview --non-interactive"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "EAS Publish Preview Android"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eas build --platform android --profile preview --non-interactive"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "三殊胜 Development"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS Publish Preview iOS"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS Publish Preview Android"

[[workflows.workflow]]
name = "三殊胜 Development"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start --port 5000"
waitForPort = 5000

[agent]
expertMode = true

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build:web"]
publicDir = "dist-web"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
