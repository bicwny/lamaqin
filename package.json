{
  "name": "san-shu-sheng",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web --output-dir dist-web",
    "serve-dist": "npx serve dist-web -l tcp://0.0.0.0:5000 --single",
    "serve-web": "npx serve dist-web -l tcp://0.0.0.0:5000 --single",
    "deploy": "npm run build:web && npm run serve-web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "eas:init": "eas init",
    "eas:build:ios": "eas build --platform ios",
    "eas:build:android": "eas build --platform android",
    "eas:build:ios:preview": "eas build --platform ios --profile preview",
    "eas:build:android:preview": "eas build --platform android --profile preview"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@babel/traverse": "^7.28.0",
    "@expo/cli": "^54.0.7",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@supabase/supabase-js": "^2.50.2",
    "expo": "~54.0.10",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.9",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.11",
    "expo-router": "~6.0.8",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.11",
    "expo-web-browser": "~15.0.7",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-elements": "^3.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "serve": "^14.2.5",
    "tailwindcss": "^3.4.17",
    "react-native-reanimated": "~3.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.12",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-reanimated": "~3.15.5"
  },
  "expo": {
    "install": {
      "exclude": ["react-native-reanimated"]
    }
  },
  "private": true
}
